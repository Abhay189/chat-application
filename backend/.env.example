APP_ENV=development
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=chat_application
DB_USER=chat_app
DB_PASSWORD=replace-with-your-application-role-password
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
CORS_ORIGINS=http://127.0.0.1:5173
# Production only, behind a trusted proxy on this machine:
# TRUST_LOCAL_PROXY=1
# DATABASE_URL=postgresql+psycopg://user:encoded-password@host:5432/database
